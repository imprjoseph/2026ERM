# 管理後台允許名單，逗號分隔。正式環境必填。
ADMIN_EMAIL_ALLOWLIST=admin@example.org

# 選用：透過 HTTPS SMTP relay 寄送郵件。未設定時使用可測試的本機替代模式。
SMTP_RELAY_URL=
SMTP_RELAY_TOKEN=
SMTP_FROM_NAME=保險業風險管理趨勢論壇活動小組
SMTP_FROM_EMAIL=forum@example.org

# 正式環境網址，用於通知信、QR Code 與行事曆連結。
PUBLIC_SITE_URL=https://forum.example.org

# 選用：Google Sheet 後台。將 integrations/google-apps-script/Code.gs
# 貼入此試算表的 Apps Script、部署為 Web App 後填入。
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=
